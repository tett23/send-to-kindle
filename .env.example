# send-to-kindle の設定の例。ユーザーの設定ファイルにコピーして値を書きかえる。
#   mkdir -p ~/.config/send-to-kindle
#   cp .env.example ~/.config/send-to-kindle/.env
#   send-to-kindle <ファイル>

# 送信元のメールアドレス（Kindle の「承認済みEメールアドレス一覧」に登録したもの）
EMAIL=me@example.com
# Kindle のメールアドレス（Kindle の「Send to Kindle Eメールアドレス」）
SEND_TO_KINDLE_EMAIL=me@kindle.com

# 送信に使う SMTP サーバー
SMTP_HOST=smtp.example.com
# 465 は最初から TLS、それ以外はサーバーが対応していれば STARTTLS で接続する
SMTP_PORT=587
SMTP_USER_NAME=me@example.com
SMTP_PASSWORD=your-password
